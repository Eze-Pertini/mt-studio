# MT Studio — Variables de entorno
# Copiar como .env.local para desarrollo

# API
VITE_API_URL=https://api.mtstudio.dev

# Medición (ver docs/MEDICION.md). En Vercel van solo en Production: sin
# VITE_GA_ID no se escribe la etiqueta, y el desarrollo y las pruebas no
# ensucian las estadísticas reales. No las cargues en .env.local.
# VITE_GA_ID=G-XXXXXXXXXX
# Destinos de las conversiones de Google Ads, cuando existan:
# VITE_ADS_WHATSAPP=AW-XXXXXXXXX/etiqueta
# VITE_ADS_FORMULARIO=AW-XXXXXXXXX/etiqueta

# EmailJS (cuando se active el formulario)
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# CMS (cuando se active)
# VITE_CMS_URL=
# VITE_CMS_TOKEN=
